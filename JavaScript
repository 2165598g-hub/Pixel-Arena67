// ============================================================
// MUSIC
// ============================================================

const musicButton =
  document.getElementById(
    "musicBtn"
  );


let music =
  null;


let musicPlaying =
  false;


musicButton.addEventListener(
  "click",
  () => {

    if (!MUSIC_URL) {

      musicButton.textContent =
        "ADD MUSIC URL";

      return;

    }


    if (!music) {

      music =
        new Audio(
          MUSIC_URL
        );


      music.loop =
        true;


      music.volume =
        0.35;

    }


    if (
      musicPlaying
    ) {

      music.pause();


      musicButton.textContent =
        "MUSIC OFF";


      musicPlaying =
        false;

    }

    else {

      music.play()
        .catch(() => {});


      musicButton.textContent =
        "MUSIC ON";


      musicPlaying =
        true;

    }

  }
);
