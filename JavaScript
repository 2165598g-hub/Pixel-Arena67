// CREATE STARS
// ============================================================

const starsContainer =
  document.getElementById("stars");


for (let i = 0; i < 120; i++) {

  const star =
    document.createElement("div");


  star.className =
    "star";


  star.style.left =
    Math.random() * 100 + "%";


  star.style.top =
    Math.random() * 100 + "%";


  const size =
    Math.random() * 2 + 1;


  star.style.width =
    size + "px";


  star.style.height =
    size + "px";


  star.style.setProperty(
    "--time",
    (
      Math.random() * 3 + 1
    )
    + "s"
  );


  starsContainer.appendChild(
    star
  );

}



// ============================================================
// IMAGE HELPER
// ============================================================

function setImage(
  imageElement,
  fallbackElement,
  url,
  fallback
) {

  if (!url) {

    imageElement.style.display =
      "none";


    fallbackElement.style.display =
      "block";


    fallbackElement.textContent =
      fallback;


    return;

  }


  imageElement.src =
    url;


  imageElement.style.display =
    "block";


  fallbackElement.style.display =
    "none";


  imageElement.onerror =
    () => {

      imageElement.style.display =
        "none";


      fallbackElement.style.display =
        "block";


      fallbackElement.textContent =
        fallback;

    };

}



