// ============================================================
// RENDER FIGHTER CARDS
// ============================================================

const fighterGrid =
  document.getElementById(
    "fighterGrid"
  );


fighters.forEach(
  (
    fighter,
    index
  ) => {

    const card =
      document.createElement(
        "div"
      );


    card.className =
      "fighter-card";


    if (index === 0) {

      card.classList.add(
        "active"
      );

    }


    card.style.setProperty(
      "--cardColor",
      fighter.color
    );


    const imageUrl =
      CHARACTER_IMAGES[
        fighter.id
      ];


    card.innerHTML = `
      <div class="fighter-image">

        ${
          imageUrl

          ?

          `<img src="${imageUrl}" alt="${fighter.name}">`

          :

          `<div class="card-fallback">${fighter.fallback}</div>`
        }

      </div>

      <strong>
        ${fighter.name}
      </strong>

      <small>
        ${fighter.team} // ${fighter.className}
      </small>
    `;


    card.addEventListener(
      "click",
      () => {

        document
          .querySelectorAll(
            ".fighter-card"
          )
          .forEach(
            item =>
              item.classList.remove(
                "active"
              )
          );


        card.classList.add(
          "active"
        );


        selectFighter(
          fighter
        );

      }
    );


    fighterGrid.appendChild(
      card
    );

  }
);



// ============================================================
// SELECT FIGHTER
// ============================================================

const selectedImage =
  document.getElementById(
    "selectedImage"
  );


const selectedFallback =
  document.getElementById(
    "selectedFallback"
  );


function selectFighter(
  fighter
) {

  setImage(

    selectedImage,

    selectedFallback,

    CHARACTER_IMAGES[
      fighter.id
    ],

    fighter.fallback

  );


  document.getElementById(
    "selectedName"
  ).textContent =
    fighter.name;


  document.getElementById(
    "selectedClass"
  ).textContent =
    fighter.className;


  document.getElementById(
    "selectedDescription"
  ).textContent =
    fighter.description;


  const team =
    document.getElementById(
      "selectedTeam"
    );


  team.textContent =
    fighter.team;


  team.classList.toggle(
    "villain",
    fighter.team === "VILLAIN"
  );


  const abilityContainer =
    document.getElementById(
      "selectedAbilities"
    );


  abilityContainer.innerHTML =
    "";


  fighter.abilities.forEach(
    ability => {

      const box =
        document.createElement(
          "div"
        );


      box.className =
        "ability";


      box.innerHTML = `
        <strong>
          ${ability.name}
        </strong>

        <span>
          ${ability.text}
        </span>
      `;


      abilityContainer.appendChild(
        box
      );

    }
  );


  document.getElementById(
    "powerBar"
  ).style.width =
    fighter.power + "%";


  document.getElementById(
    "speedBar"
  ).style.width =
    fighter.speed + "%";


  document.getElementById(
    "defenseBar"
  ).style.width =
    fighter.defense + "%";

}



