:root {
  --black: #05050a;
  --dark: #090a11;
  --panel: #0d101b;
  --panel2: #121625;

  --white: #f5f6ff;
  --muted: #8389a3;

  --cyan: #67efff;
  --blue: #417cff;
  --purple: #835dff;
  --pink: #e857ff;

  --red: #ff4858;
  --orange: #ff7b32;

  --border: #292d45;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;

  background: var(--black);
  color: var(--white);

  font-family:
    "Courier New",
    monospace;

  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
}


/* ============================================================
   NAV
============================================================ */

.nav {
  position: fixed;

  z-index: 1000;

  top: 0;
  left: 0;

  width: 100%;
  height: 70px;

  padding: 0 5%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background:
    rgba(5, 5, 10, .88);

  backdrop-filter:
    blur(14px);

  border-bottom:
    1px solid var(--border);
}

.logo {
  font-weight: 900;

  letter-spacing: 2px;
}

.logo span {
  color: var(--cyan);

  text-shadow:
    0 0 18px var(--cyan);
}

.nav-links {
  display: flex;

  gap: 30px;

  font-size: 11px;

  color: #a1a6bc;
}

.nav-links a {
  transition: .2s;
}

.nav-links a:hover {
  color: white;

  text-shadow:
    0 0 12px var(--cyan);
}

.nav-button {
  padding: 10px 15px;

  color: var(--cyan);

  background:
    #111624;

  border:
    1px solid #34405e;

  cursor: pointer;

  font-size: 10px;
  font-weight: bold;
}


/* ============================================================
   GLOBAL
============================================================ */

.section {
  padding:
    120px 7%;
}

.eyebrow {
  margin-bottom: 18px;

  color: var(--cyan);

  font-size: 10px;

  letter-spacing: 3px;
}

.eyebrow.red {
  color: var(--red);
}

.section h2,
.final-section h2 {
  margin: 0;

  font-family:
    Impact,
    fantasy;

  font-size:
    clamp(52px, 7vw, 100px);

  line-height: .9;

  letter-spacing: 2px;
}

.section h2 span,
.final-section h2 span {
  color: transparent;

  -webkit-text-stroke:
    1px var(--cyan);

  text-shadow:
    0 0 25px
    rgba(103, 239, 255, .2);
}


/* ============================================================
   HERO
============================================================ */

.hero {
  position: relative;

  min-height: 100vh;

  padding:
    130px 8% 80px;

  display: grid;

  grid-template-columns:
    1.2fr .8fr;

  gap: 70px;

  align-items: center;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 70% 30%,
      rgba(131, 93, 255, .22),
      transparent 35%
    ),

    radial-gradient(
      circle at 20% 70%,
      rgba(103, 239, 255, .12),
      transparent 30%
    ),

    #05050a;
}

#stars {
  position: absolute;

  inset: 0;

  pointer-events: none;
}

.star {
  position: absolute;

  width: 2px;
  height: 2px;

  background: white;

  animation:
    starBlink var(--time)
    infinite alternate;
}

@keyframes starBlink {
  from {
    opacity: .15;
  }

  to {
    opacity: 1;
  }
}

.planet {
  position: absolute;

  border-radius: 50%;

  pointer-events: none;
}

.planet-1 {
  width: 420px;
  height: 420px;

  right: -210px;
  top: 13%;

  opacity: .35;

  background:
    radial-gradient(
      circle at 30% 25%,
      #9e79ff,
      #33285f 55%,
      #0a0a12 75%
    );

  box-shadow:
    0 0 100px
    rgba(130, 90, 255, .28);
}

.planet-2 {
  width: 90px;
  height: 90px;

  left: 46%;
  top: 16%;

  opacity: .5;

  background:
    radial-gradient(
      circle at 30% 25%,
      #9df6ff,
      #1d6177 50%,
      #070a11
    );
}

.hero-content {
  position: relative;

  z-index: 3;
}

.hero h1 {
  margin: 0;

  font-family:
    Impact,
    fantasy;

  font-size:
    clamp(80px, 11vw, 170px);

  line-height: .76;

  letter-spacing: 4px;
}

.hero h1 span {
  display: block;

  color: transparent;

  -webkit-text-stroke:
    1px var(--cyan);

  text-shadow:
    0 0 30px
    rgba(75, 222, 255, .25);
}

.hero h2 {
  margin:
    35px 0 0;

  color: #d6daed;

  font-size:
    clamp(18px, 2vw, 28px);

  letter-spacing: 2px;

  line-height: 1.4;
}

.hero-content > p {
  max-width: 620px;

  margin:
    25px 0;

  color: #9298ae;

  line-height: 1.8;

  font-size: 14px;
}

.hero-buttons {
  display: flex;

  gap: 15px;

  flex-wrap: wrap;
}

.btn {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 25px;

  padding:
    15px 22px;

  border:
    1px solid #3a405a;

  font-size: 11px;
  font-weight: bold;

  letter-spacing: 1px;

  transition: .2s;
}

.btn-primary {
  background: white;

  color: #06070b;

  box-shadow:
    7px 7px 0 var(--purple);
}

.btn-primary:hover {
  transform:
    translate(-3px, -3px);

  box-shadow:
    11px 11px 0 var(--pink);
}

.btn-secondary:hover {
  border-color: var(--cyan);

  color: var(--cyan);
}

.hero-stats {
  display: flex;

  gap: 40px;

  margin-top: 50px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
}

.hero-stats strong {
  color: white;

  font-size: 25px;
}

.hero-stats span {
  margin-top: 5px;

  color: #646b83;

  font-size: 9px;

  letter-spacing: 2px;
}


/* ============================================================
   HERO CHARACTER
============================================================ */

.hero-showcase {
  position: relative;

  z-index: 3;

  min-height: 570px;

  border:
    1px solid #323651;

  background:
    linear-gradient(
      180deg,
      rgba(126, 90, 255, .15),
      rgba(10, 12, 22, .85)
    );

  box-shadow:
    18px 18px 0
    rgba(91, 62, 170, .15);

  overflow: hidden;
}

.status {
  position: absolute;

  top: 20px;
  left: 20px;

  display: flex;

  gap: 8px;

  align-items: center;

  color: #9ba3bc;

  font-size: 9px;

  letter-spacing: 2px;
}

.status span {
  width: 8px;
  height: 8px;

  background:
    #54ff8c;

  box-shadow:
    0 0 12px #54ff8c;
}

.character-display {
  position: absolute;

  inset:
    65px 25px 80px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.character-display img {
  max-width: 90%;
  max-height: 100%;

  image-rendering: pixelated;

  filter:
    drop-shadow(
      0 0 30px
      rgba(118, 81, 255, .55)
    );
}

.character-fallback {
  font-size: 170px;

  filter:
    drop-shadow(
      0 0 25px
      rgba(115, 82, 255, .5)
    );
}

.showcase-name {
  position: absolute;

  left: 25px;
  bottom: 43px;

  font-size: 21px;

  font-weight: bold;

  letter-spacing: 2px;
}

.showcase-class {
  position: absolute;

  left: 25px;
  bottom: 23px;

  color: var(--cyan);

  font-size: 9px;

  letter-spacing: 2px;
}

.hero-scanline {
  position: absolute;

  z-index: 4;

  left: 0;
  top: -10%;

  width: 100%;
  height: 3px;

  background:
    rgba(94, 238, 255, .7);

  box-shadow:
    0 0 20px var(--cyan);

  animation:
    scan 5s linear infinite;
}

@keyframes scan {
  to {
    top: 110%;
  }
}

.target-corner {
  position: absolute;

  width: 25px;
  height: 25px;
}

.top-left {
  top: 12px;
  left: 12px;

  border-top:
    2px solid var(--cyan);

  border-left:
    2px solid var(--cyan);
}

.top-right {
  top: 12px;
  right: 12px;

  border-top:
    2px solid var(--cyan);

  border-right:
    2px solid var(--cyan);
}

.bottom-left {
  bottom: 12px;
  left: 12px;

  border-bottom:
    2px solid var(--cyan);

  border-left:
    2px solid var(--cyan);
}

.bottom-right {
  bottom: 12px;
  right: 12px;

  border-bottom:
    2px solid var(--cyan);

  border-right:
    2px solid var(--cyan);
}


/* ============================================================
   TICKER
============================================================ */

.ticker {
  overflow: hidden;

  border-top:
    1px solid #382a4d;

  border-bottom:
    1px solid #382a4d;

  background:
    #0c0812;
}

.ticker-content {
  width: max-content;

  padding: 13px 0;

  display: flex;

  gap: 70px;

  color: #ca9cff;

  font-size: 10px;

  letter-spacing: 2px;

  animation:
    ticker 24s linear infinite;
}

@keyframes ticker {
  from {
    transform:
      translateX(0);
  }

  to {
    transform:
      translateX(-50%);
  }
}


/* ============================================================
   SECTION HEADER
============================================================ */

.section-header {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 60px;

  margin-bottom: 55px;
}

.section-header p {
  max-width: 420px;

  color: var(--muted);

  line-height: 1.8;
}


/* ============================================================
   FIGHTERS
============================================================ */

.fighter-grid {
  display: grid;

  grid-template-columns:
    repeat(7, 1fr);

  gap: 12px;

  margin-bottom: 45px;
}

.fighter-card {
  position: relative;

  min-height: 210px;

  padding:
    13px;

  overflow: hidden;

  border:
    1px solid var(--border);

  background:
    var(--panel);

  cursor: pointer;

  transition: .2s;
}

.fighter-card:hover,
.fighter-card.active {
  transform:
    translateY(-6px);

  border-color:
    var(--cardColor);

  box-shadow:
    0 12px 30px
    rgba(0,0,0,.35);
}

.fighter-image {
  height: 130px;

  display: flex;

  align-items: center;
  justify-content: center;

  overflow: hidden;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,.06),
      transparent 65%
    );
}

.fighter-image img {
  max-width: 100%;
  max-height: 100%;

  image-rendering: pixelated;
}

.card-fallback {
  font-size: 65px;
}

.fighter-card strong {
  display: block;

  margin-top: 13px;

  font-size: 11px;
}

.fighter-card small {
  display: block;

  margin-top: 5px;

  color: #717890;

  font-size: 8px;
}


/* ============================================================
   DOSSIER
============================================================ */

.dossier {
  display: grid;

  grid-template-columns:
    .8fr 1.2fr;

  min-height: 500px;

  border:
    1px solid var(--border);

  background:
    #090b13;
}

.dossier-visual {
  position: relative;

  min-height: 500px;

  display: flex;

  align-items: center;
  justify-content: center;

  overflow: hidden;

  background:
    radial-gradient(
      circle,
      rgba(119, 78, 255, .18),
      transparent 65%
    );
}

.scan-grid {
  position: absolute;

  inset: 0;

  opacity: .15;

  background-image:

    linear-gradient(
      rgba(255,255,255,.08)
      1px,
      transparent 1px
    ),

    linear-gradient(
      90deg,
      rgba(255,255,255,.08)
      1px,
      transparent 1px
    );

  background-size:
    30px 30px;
}

.dossier-visual img {
  position: relative;

  z-index: 2;

  max-width: 80%;
  max-height: 430px;

  image-rendering: pixelated;

  filter:
    drop-shadow(
      0 0 30px
      rgba(119, 78, 255, .45)
    );
}

.dossier-fallback {
  position: relative;

  z-index: 2;

  font-size: 180px;
}

.dossier-info {
  padding:
    60px;

  border-left:
    1px solid var(--border);
}

.team-tag {
  display: inline-block;

  padding:
    5px 8px;

  margin-bottom: 20px;

  color: #06100b;

  background:
    #61f69a;

  font-size: 9px;

  font-weight: bold;
}

.team-tag.villain {
  color: white;

  background:
    var(--red);
}

.dossier-info h3 {
  margin: 0;

  font-family:
    Impact,
    fantasy;

  font-size:
    clamp(44px, 5vw, 75px);

  letter-spacing: 2px;
}

.class-name {
  margin:
    8px 0 25px;

  color: var(--cyan);

  font-size: 11px;

  letter-spacing: 2px;
}

.dossier-info > p {
  max-width: 650px;

  color: #9097ae;

  line-height: 1.8;

  font-size: 13px;
}

.abilities-title {
  margin-top: 35px;

  color: #5f6881;

  font-size: 9px;

  letter-spacing: 3px;
}

.ability-list {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 10px;

  margin-top: 13px;
}

.ability {
  padding:
    14px;

  border:
    1px solid #2c3045;

  background:
    #10131f;
}

.ability strong {
  display: block;

  color: #edf2ff;

  font-size: 10px;
}

.ability span {
  display: block;

  margin-top: 5px;

  color: #727990;

  font-size: 9px;

  line-height: 1.5;
}

.stats {
  margin-top: 35px;

  display: grid;

  gap: 15px;
}

.stat {
  display: grid;

  grid-template-columns:
    80px 1fr;

  align-items: center;
}

.stat span {
  color: #727990;

  font-size: 9px;
}

.stat-bar {
  height: 7px;

  background:
    #1b2030;
}

.stat-bar div {
  height: 100%;

  background:
    linear-gradient(
      90deg,
      var(--cyan),
      var(--purple)
    );
}


/* ============================================================
   SKYFORTRESS
============================================================ */

.fortress-section {
  display: grid;

  grid-template-columns:
    .8fr 1.2fr;

  gap: 90px;

  align-items: center;

  background:
    linear-gradient(
      180deg,
      #070a11,
      #0a0d18
    );
}

.fortress-info > p {
  max-width: 580px;

  color: var(--muted);

  line-height: 1.8;
}

.room-list {
  display: grid;

  gap: 9px;

  margin-top: 35px;
}

.room-card {
  display: flex;

  gap: 18px;

  align-items: center;

  padding:
    14px;

  border:
    1px solid #22293a;

  background:
    #0e121e;

  transition: .2s;
}

.room-card:hover {
  border-color:
    var(--cyan);

  transform:
    translateX(6px);
}

.room-card > span {
  color: var(--cyan);

  font-size: 17px;
}

.room-card strong {
  display: block;

  font-size: 11px;
}

.room-card small {
  color: #757c92;

  font-size: 9px;
}

.ship-wrapper {
  position: relative;

  min-height: 570px;

  display: flex;

  align-items: center;
  justify-content: center;
}

.ship {
  position: relative;

  width: 600px;
  height: 480px;

  border:
    3px solid #45536b;

  background:
    #101724;

  box-shadow:
    0 0 60px
    rgba(66, 128, 255, .1);
}

.ship-room {
  position: absolute;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #79849d;

  border:
    2px solid #3b465c;

  background:
    #171e2c;

  font-size: 10px;

  letter-spacing: 1px;
}

.cockpit {
  top: 20px;
  left: 190px;

  width: 220px;
  height: 80px;
}

.medbay {
  top: 150px;
  left: 20px;

  width: 150px;
  height: 180px;
}

.armory {
  top: 150px;
  right: 20px;

  width: 150px;
  height: 180px;
}

.reactor {
  top: 145px;
  left: 220px;

  width: 160px;
  height: 170px;

  flex-direction: column;

  gap: 10px;
}

.reactor-core {
  width: 55px;
  height: 55px;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #cfb7ff;

  background:
    #5438b8;

  box-shadow:
    0 0 25px
    #6e54ff;

  animation:
    reactorPulse 1.5s infinite alternate;
}

@keyframes reactorPulse {
  to {
    box-shadow:
      0 0 50px
      #9d67ff;
  }
}

.hangar {
  bottom: 20px;
  left: 150px;

  width: 300px;
  height: 90px;
}

.corridor {
  position: absolute;

  background:
    #273246;
}

.corridor.vertical {
  width: 50px;
  height: 310px;

  top: 95px;
  left: 275px;
}

.corridor.horizontal {
  width: 410px;
  height: 45px;

  top: 350px;
  left: 95px;
}

.player-dot {
  position: absolute;

  z-index: 5;

  width: 12px;
  height: 12px;

  border-radius: 50%;
}

.dot-1 {
  left: 285px;
  top: 335px;

  background:
    var(--cyan);

  box-shadow:
    0 0 12px var(--cyan);
}

.dot-2 {
  left: 100px;
  top: 250px;

  background:
    #61f797;

  box-shadow:
    0 0 12px #61f797;
}

.dot-3 {
  right: 100px;
  top: 225px;

  background:
    var(--red);

  box-shadow:
    0 0 12px var(--red);
}


/* ============================================================
   GAMEPLAY
============================================================ */

.center-heading {
  text-align: center;

  max-width: 900px;

  margin:
    0 auto 70px;
}

.gameplay-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 15px;
}

.gameplay-grid article {
  position: relative;

  min-height: 300px;

  padding:
    30px;

  border:
    1px solid var(--border);

  background:
    var(--panel);

  transition: .25s;
}

.gameplay-grid article:hover {
  transform:
    translateY(-8px);

  border-color:
    var(--purple);
}

.gameplay-icon {
  font-size: 45px;

  color: var(--cyan);
}

.number {
  position: absolute;

  right: 20px;
  top: 20px;

  color: #32384c;

  font-size: 25px;
}

.gameplay-grid h3 {
  margin-top: 60px;

  font-size: 16px;

  letter-spacing: 2px;
}

.gameplay-grid p {
  color: #858ba0;

  line-height: 1.7;

  font-size: 11px;
}


/* ============================================================
   HEROES VS VILLAINS
============================================================ */

.alignment-section {
  position: relative;

  display: grid;

  grid-template-columns:
    1fr 1fr;

  min-height: 600px;
}

.alignment-side {
  padding:
    100px 8%;

  display: flex;

  flex-direction: column;
  justify-content: center;
}

.heroes-side {
  background:
    radial-gradient(
      circle at 20% 50%,
      rgba(68, 200, 255, .16),
      transparent 45%
    ),

    #071019;
}

.villains-side {
  text-align: right;

  align-items: flex-end;

  background:
    radial-gradient(
      circle at 80% 50%,
      rgba(255, 54, 80, .18),
      transparent 45%
    ),

    #13070b;
}

.alignment-side h2 {
  margin: 0;

  font-family:
    Impact,
    fantasy;

  font-size:
    clamp(70px, 9vw, 135px);
}

.heroes-side h2 {
  color: var(--cyan);
}

.villains-side h2 {
  color: var(--red);
}

.alignment-side p {
  max-width: 500px;

  color: #8d93a7;

  line-height: 1.8;
}

.alignment-names {
  margin-top: 35px;

  color: #cfd4e6;

  line-height: 2;

  font-size: 11px;

  letter-spacing: 2px;
}

.alignment-divider {
  position: absolute;

  z-index: 5;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%);

  width: 75px;
  height: 75px;

  display: flex;

  align-items: center;
  justify-content: center;

  background: white;

  color: black;

  font-size: 20px;

  font-weight: bold;

  box-shadow:
    8px 8px 0
    var(--purple);
}


/* ============================================================
   EMERGENCIES
============================================================ */

.emergency-section {
  background:
    #08090e;
}

.emergency-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 15px;
}

.emergency-grid article {
  padding:
    25px;

  border:
    1px solid #39232a;

  background:
    #120b0e;

  transition: .2s;
}

.emergency-grid article:hover {
  border-color:
    var(--red);

  box-shadow:
    0 0 25px
    rgba(255, 72, 88, .12);
}

.warning {
  color: var(--red);

  font-size: 30px;

  animation:
    warningBlink 1s infinite alternate;
}

@keyframes warningBlink {
  from {
    opacity: .3;
  }

  to {
    opacity: 1;
  }
}

.emergency-grid h3 {
  margin:
    25px 0 15px;

  font-size: 13px;

  letter-spacing: 1px;
}

.emergency-grid p {
  color: #88767c;

  line-height: 1.8;

  font-size: 10px;
}


/* ============================================================
   LORE
============================================================ */

.lore-section {
  background:
    radial-gradient(
      circle at center,
      rgba(97, 67, 175, .12),
      transparent 50%
    );
}

.lore-title {
  text-align: center;

  margin-bottom: 65px;
}

.lore-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;

  max-width: 1250px;

  margin: auto;
}

.lore-grid article {
  min-height: 350px;

  padding:
    35px;

  border:
    1px solid var(--border);

  background:
    rgba(13, 15, 25, .8);
}

.lore-grid article > span {
  color: var(--cyan);

  font-size: 9px;

  letter-spacing: 2px;
}

.lore-grid h3 {
  margin-top: 110px;

  font-size: 18px;
}

.lore-grid p {
  color: #81879c;

  font-size: 11px;

  line-height: 1.8;
}


/* ============================================================
   FINAL CTA
============================================================ */

.final-section {
  position: relative;

  min-height: 600px;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  text-align: center;

  overflow: hidden;

  background:
    #07070c;
}

.final-glow {
  position: absolute;

  width: 600px;
  height: 600px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(116, 78, 255, .24),
      transparent 65%
    );
}

.final-section > * {
  position: relative;

  z-index: 2;
}

.final-section p {
  color: #8a90a5;

  line-height: 1.8;
}

.giant {
  margin-top: 25px;

  padding:
    18px 30px;
}


/* ============================================================
   FOOTER
============================================================ */

footer {
  padding:
    30px 6%;

  display: flex;

  justify-content: space-between;

  color: #555c70;

  border-top:
    1px solid var(--border);

  font-size: 9px;

  letter-spacing: 1px;
}

footer strong {
  color: #c7cada;
}


/* ============================================================
   RESPONSIVE
============================================================ */

@media (max-width: 1050px) {

  .hero {
    grid-template-columns:
      1fr;
  }

  .hero-showcase {
    min-height: 500px;
  }

  .fighter-grid {
    grid-template-columns:
      repeat(4, 1fr);
  }

  .dossier {
    grid-template-columns:
      1fr;
  }

  .dossier-info {
    border-left: none;

    border-top:
      1px solid var(--border);
  }

  .fortress-section {
    grid-template-columns:
      1fr;
  }

  .gameplay-grid,
  .emergency-grid {
    grid-template-columns:
      1fr 1fr;
  }

}


@media (max-width: 720px) {

  .nav-links {
    display: none;
  }

  .hero {
    padding:
      120px 25px 60px;
  }

  .section {
    padding:
      90px 25px;
  }

  .hero-stats {
    gap: 20px;
  }

  .section-header {
    flex-direction: column;

    align-items: flex-start;
  }

  .fighter-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .dossier-info {
    padding:
      30px;
  }

  .ability-list {
    grid-template-columns:
      1fr;
  }

  .gameplay-grid,
  .emergency-grid,
  .lore-grid {
    grid-template-columns:
      1fr;
  }

  .alignment-section {
    grid-template-columns:
      1fr;
  }

  .alignment-divider {
    display: none;
  }

  .villains-side {
    text-align: left;

    align-items: flex-start;
  }

  .ship {
    transform:
      scale(.7);
  }

  footer {
    flex-direction: column;

    gap: 10px;
  }

}
